#!/usr/bin/env python3
"""Render the doctrine or the delegation facts from the stores, or rewrite them canonically."""

import argparse
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import doctrine  # noqa: E402
import stores  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="agent-routing")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("doctrine", help="the principles and the policy rendered from the stores")
    commands.add_parser("delegation", help="backend, reachability and pool rows")
    formatting = commands.add_parser("format", help="rewrite every store in canonical form")
    formatting.add_argument("--check", action="store_true", help="name stores not in canonical form; write nothing")
    args = parser.parse_args()
    try:
        if args.command == "doctrine":
            print(doctrine.render(ROOT), end="")
        elif args.command == "delegation":
            print(doctrine.delegation(ROOT), end="")
        elif args.check:
            problems = stores.canonical_problems(ROOT)
            print("\n".join(problems) or "every store is in canonical form")
            return 1 if problems else 0
        else:
            changed = stores.format_stores(ROOT)
            print("rewrote " + ", ".join(changed) if changed else "every store is in canonical form")
    except (OSError, stores.StoreError) as error:
        print(f"agent-routing: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
