#!/usr/bin/env python3
"""Export capability history using the Arc ladder interchange schema."""

import argparse
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from review_ladder import export

parser = argparse.ArgumentParser(prog="agent-routing ladder")
parser.add_argument("--json", action="store_true", required=True, help="emit arc-review-ladder/1")
parser.add_argument("--history", action="store_true", help="include the numeric-era history and preceding gap")
args = parser.parse_args()
try:
    result = export(ROOT, history=args.history)
except (ValueError, KeyError, TypeError) as error:
    print(f"agent-routing: cannot export ladder: {error}", file=sys.stderr)
    raise SystemExit(1)
print(json.dumps(result, indent=2, sort_keys=True))
