#!/usr/bin/env python3
"""Emit a reviewable Claude agent bundle without modifying a live harness."""

import argparse
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from claude_agents import claude_agent_bundle
from routing_profiles import RouteRefusal, dumps


def main():
    parser = argparse.ArgumentParser(prog="agent-routing emit")
    parser.add_argument("target", choices=["claude-agents"])
    parser.add_argument("--profile")
    parser.add_argument("--variant")
    parser.add_argument("--allow-experimental", action="store_true")
    parser.add_argument("--output-dir", type=pathlib.Path, help="write agents/ and consumers-pins.toml beneath this directory")
    parser.add_argument("--check", action="store_true", help="compare the output directory without writing")
    args = parser.parse_args()
    if args.check and args.output_dir is None:
        parser.error("--check requires --output-dir")
    try:
        bundle = claude_agent_bundle(ROOT, profile_id=args.profile, variant_id=args.variant,
                                     allow_experimental=args.allow_experimental)
        if args.output_dir is not None:
            for name, content in bundle["files"].items():
                path = args.output_dir / name
                if args.check:
                    if not path.is_file() or path.read_text() != content:
                        raise RouteRefusal("generated-drift", f"generated content differs: {name}")
                else:
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_text(content)
    except RouteRefusal as error:
        print(f"agent-routing: {error}", file=sys.stderr)
        print(dumps(error.payload()), file=sys.stderr)
        return 1
    except (OSError, ValueError, KeyError) as error:
        print(f"agent-routing: cannot emit Claude agents: {error}", file=sys.stderr)
        return 1
    print(dumps(bundle))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
