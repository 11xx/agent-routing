#!/usr/bin/env python3
"""Project the declared profile and variant bindings without choosing a task."""
import argparse
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))
from routing_profiles import RouteRefusal, dumps, seats_view

parser = argparse.ArgumentParser(prog="agent-routing seats")
parser.add_argument("--json", action="store_true")
args = parser.parse_args()
try:
    answer = seats_view(ROOT)
except RouteRefusal as error:
    print(f"agent-routing: {error}", file=sys.stderr)
    print(dumps(error.payload()), file=sys.stderr)
    raise SystemExit(1)
if args.json:
    print(dumps(answer))
else:
    print("profile\tvariant\tbackend\tprovider\tmodel\teffort\tstability\tdefault")
    for seat in answer["seats"]:
        print("\t".join(str(seat[key]) if seat[key] is not None else "-" for key in
                        ("profile", "variant", "backend", "provider", "model", "effort", "stability", "default")))
    head = answer["head_default"]
    if head is None:
        print("head default: plan/claude binding absent")
    else:
        print(f"head default: {head['model']}#{head['effort']} via {head['backend']}/{head['provider']}")
    print("actual head: unobserved")
    print(f"route version: {answer['route_version']}")
