#!/usr/bin/env python3
"""Reject concrete roster pins in active delegation consumer sources."""

import json
import os
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import stores  # noqa: E402
from routing_profiles import RouteRefusal, data, dumps, resolve  # noqa: E402


def consumer_code_root():
    override = os.environ.get("AGENT_CODE_ROOT")
    if override is not None:
        return pathlib.Path(override)
    result = subprocess.run(
        ["git", "-C", str(ROOT), "rev-parse", "--path-format=absolute", "--git-common-dir"],
        capture_output=True, text=True,
    )
    if result.returncode == 0:
        return pathlib.Path(result.stdout.strip()).parent.parent
    return ROOT.parent


CODE = consumer_code_root()


def files_under(path):
    if path.is_file():
        yield path
        return
    for member in path.rglob("*"):
        if member.is_file() and ".git" not in member.parts and "node_modules" not in member.parts:
            yield member


def configured_consumers():
    config = data(ROOT).policy
    repositories = {row["id"]: row["name"] for row in config.get("repository", [])}
    consumers = []
    by_id = {}
    entries = []
    for consumer in config.get("consumer", []):
        consumer_id = consumer["id"]
        if consumer_id in by_id:
            raise SystemExit(f"duplicate delegation consumer: {consumer_id}")
        if consumer.get("generated") not in (None, "claude-agents"):
            raise SystemExit(f"{consumer_id}: unknown generated consumer {consumer['generated']!r}")
        repository = consumer["repository"]
        if repository not in repositories:
            raise SystemExit(f"unknown delegation repository {repository!r} for {consumer_id}")
        entry = {
            **consumer,
            "root": CODE / repositories[repository] / consumer["path"],
        }
        by_id[consumer_id] = entry
        entries.append(entry)

    for accessor in config.get("accessor", []):
        accessor_id = accessor["id"]
        expected = accessor.get("expected_sources")
        if not isinstance(expected, list) or not expected or not all(isinstance(name, str) for name in expected):
            raise SystemExit(f"{accessor_id}: {stores.POLICY} declares no expected_sources floor")
        command = list(accessor["command"])
        if command and command[0] == "agent-harness":
            command[0] = os.environ.get("AGENT_HARNESS_BIN", command[0])
        try:
            result = subprocess.run(command, capture_output=True, text=True, check=True)
        except FileNotFoundError:
            raise SystemExit(f"{accessor_id}: command not found: {' '.join(command)}")
        except subprocess.CalledProcessError as error:
            detail = error.stderr.strip() or error.stdout.strip()
            raise SystemExit(f"{accessor_id}: {' '.join(command)} failed: {detail}")
        try:
            sources = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise SystemExit(f"{accessor_id}: invalid delegation source JSON: {error}")
        if not isinstance(sources, list):
            raise SystemExit(f"{accessor_id}: delegation source output must be a JSON array")
        # A lint that cannot find its subject has not passed. The config owns
        # the floor of sources the accessor must report, so a harness-side
        # regression that drops surfaces, down to none, fails here instead of
        # shrinking the count below.
        missing_sources = [name for name in expected if name not in {source["id"] for source in sources}]
        if missing_sources:
            raise SystemExit(
                f"{accessor_id}: missing expected delegation sources: {', '.join(missing_sources)}"
            )
        for source in sources:
            source_id = source["id"]
            consumer_id = f"{accessor_id}/{source_id}"
            if consumer_id in by_id:
                raise SystemExit(f"duplicate delegation consumer: {consumer_id}")
            path = pathlib.Path(source["path"])
            if not path.is_absolute():
                path = CODE / path
            entry = {
                "id": consumer_id,
                "root": path,
                "checks": source["checks"],
            }
            by_id[consumer_id] = entry
            entries.append(entry)

    proxy_pins = {}
    for proxy in config.get("proxy", []):
        consumer_id = proxy["consumer"]
        if consumer_id not in by_id:
            raise SystemExit(f"unknown proxy consumer: {consumer_id}")
        path = by_id[consumer_id]["root"] / proxy["path"]
        if path in proxy_pins:
            raise SystemExit(f"duplicate delegation proxy: {path}")
        proxy_pins[path] = (proxy["model"], proxy["effort"])

    route_pins = {}
    for pin in config.get("pin", []):
        consumer_id = pin["consumer"]
        if consumer_id not in by_id:
            raise SystemExit(f"unknown pin consumer: {consumer_id}")
        path = by_id[consumer_id]["root"] / pin["path"]
        if path in proxy_pins or path in route_pins:
            raise SystemExit(f"duplicate delegation pin: {path}")
        proxy_pins[path] = (pin["model"], pin["effort"])
        route_pins[path] = pin
    # A lint that cannot find its subject has not passed. An accessor that
    # names nothing is refused above; an inventory declaring no consumers and
    # no accessors leaves the same count of zero behind, silently.
    if not entries:
        raise SystemExit(f"{stores.POLICY} declares no delegation consumers or accessors")
    return entries, proxy_pins, route_pins


def resolved_route(pin):
    """What `agent-routing resolve` answers for the profile a pinned definition claims."""
    try:
        return resolve(ROOT, pin["profile"], pin["backend"], variant_id=pin.get("variant"),
                       allow_experimental=bool(pin.get("allow_experimental")))
    except RouteRefusal as refusal:
        raise SystemExit(f"cannot resolve pin {pin['path']}: agent-routing: cannot resolve profile "
                         f"{pin['profile']!r} for backend {pin['backend']!r}: {refusal}\n{dumps(refusal.payload())}")


def main():
    try:
        loaded = data(ROOT)
    except RouteRefusal as refusal:
        print(f"lint-consumers: the routing data is invalid: {refusal}")
        return 2
    models, profiles = loaded.models, loaded.profiles
    literals = {model["id"] for model in models}
    for profile in profiles:
        for route in [profile, *profile.get("variant", [])]:
            if route.get("backend_model"):
                literals.add(route["backend_model"])

    consumers, proxy_pins, route_pins = configured_consumers()
    missing = [consumer["root"] for consumer in consumers if not consumer["root"].exists()]
    if missing:
        for path in missing:
            print(f"missing delegation consumer: {path}")
        return 2

    missing_proxies = [path for path in proxy_pins if not path.is_file()]
    if missing_proxies:
        for path in missing_proxies:
            print(f"missing delegation proxy: {path}")
        return 2

    generated_consumers = [consumer for consumer in consumers if consumer.get("generated") == "claude-agents"]
    if generated_consumers:
        sys.path.insert(0, str(ROOT / "lib"))
        from claude_agents import claude_agent_bundle
        bundle = claude_agent_bundle(ROOT, allow_experimental=True)
        for consumer in generated_consumers:
            for pin in bundle["pins"]:
                path = consumer["root"] / pin["path"]
                if path.is_file() and path not in route_pins:
                    proxy_pins[path] = (pin["model"], pin["effort"])
                    route_pins[path] = pin

    problems = []
    for path, pin in route_pins.items():
        route = resolved_route(pin)
        if pin.get("generated"):
            sys.path.insert(0, str(ROOT / "lib"))
            from claude_agents import claude_agent_bundle
            bundle = claude_agent_bundle(ROOT, profile_id=pin["profile"],
                                         variant_id=pin.get("variant"),
                                         allow_experimental=pin.get("allow_experimental", False))
            expected = bundle["files"].get(f"agents/{pin['path']}")
            if expected is None or path.read_text() != expected:
                problems.append(f"{path}: generated agent differs from the resolved route template")
        if route["effort"] != pin["effort"]:
            problems.append(
                f"{path}: pinned effort {pin['effort']} but {pin['profile']}:{pin['variant']} resolves to {route['effort']}"
            )
        if not route["model"].startswith(f"{pin['backend']}-{pin['model']}"):
            problems.append(
                f"{path}: pinned model alias {pin['model']} but {pin['profile']}:{pin['variant']} resolves to {route['model']}"
            )
    for consumer in consumers:
        checks = set(consumer.get("checks", []))
        for path in files_under(consumer["root"]):
            try:
                text = path.read_text()
            except UnicodeDecodeError:
                continue
            for line_number, line in enumerate(text.splitlines(), 1):
                if "roster-literals" in checks:
                    found = sorted(literal for literal in literals if literal in line)
                    if found:
                        problems.append(f"{path}:{line_number}: concrete route literal: {', '.join(found)}")
                stripped = line.strip()
                if "agent-frontmatter" in checks and path.suffix == ".md" and stripped.startswith("model:"):
                    if path not in proxy_pins or stripped != f"model: {proxy_pins[path][0]}":
                        problems.append(f"{path}:{line_number}: delegation source pins model frontmatter")
                if path in proxy_pins and stripped.startswith("effort:") and stripped != f"effort: {proxy_pins[path][1]}":
                    problems.append(f"{path}:{line_number}: definition changed its centrally recorded effort")
                if "pi-route" in checks and '"defaultModel"' in stripped:
                    problems.append(f"{path}:{line_number}: Pi default must use $route, not defaultModel")

    for problem in problems:
        print(problem)
    if problems:
        print(f"\n{len(problems)} consumer routing pin(s); use a named agent-routing profile")
        return 1
    print(f"delegation consumers contain no concrete roster pins across {len(consumers)} declared consumer entries")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
