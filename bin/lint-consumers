#!/usr/bin/env python3
"""Reject concrete roster pins in active delegation consumer sources."""

import json
import os
import pathlib
import subprocess
import sys
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
CODE = pathlib.Path(os.environ.get("AI_AGENT_CODE_ROOT", ROOT.parent))


def load(path):
    with path.open("rb") as handle:
        return tomllib.load(handle)


def files_under(path):
    if path.is_file():
        yield path
        return
    for member in path.rglob("*"):
        if member.is_file() and ".git" not in member.parts and "node_modules" not in member.parts:
            yield member


def configured_consumers():
    config = load(ROOT / "routing" / "consumers.toml")
    repositories = config.get("repository", {})
    consumers = []
    by_id = {}
    entries = []
    for consumer in config.get("consumer", []):
        consumer_id = consumer["id"]
        if consumer_id in by_id:
            raise SystemExit(f"duplicate delegation consumer: {consumer_id}")
        repository = consumer["repository"]
        if repository not in repositories:
            raise SystemExit(f"unknown delegation repository {repository!r} for {consumer_id}")
        entry = {
            **consumer,
            "root": CODE / repositories[repository] / consumer["path"],
        }
        by_id[consumer_id] = entry
        entries.append(entry)

    for accessor in config.get("accessor", []):
        accessor_id = accessor["id"]
        command = list(accessor["command"])
        if command and command[0] == "agent-harness":
            command[0] = os.environ.get("AGENT_HARNESS_BIN", command[0])
        try:
            result = subprocess.run(command, capture_output=True, text=True, check=True)
        except FileNotFoundError:
            raise SystemExit(f"{accessor_id}: command not found: {' '.join(command)}")
        except subprocess.CalledProcessError as error:
            detail = error.stderr.strip() or error.stdout.strip()
            raise SystemExit(f"{accessor_id}: {' '.join(command)} failed: {detail}")
        try:
            sources = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise SystemExit(f"{accessor_id}: invalid delegation source JSON: {error}")
        if not isinstance(sources, list):
            raise SystemExit(f"{accessor_id}: delegation source output must be a JSON array")
        for source in sources:
            source_id = source["id"]
            consumer_id = f"{accessor_id}/{source_id}"
            if consumer_id in by_id:
                raise SystemExit(f"duplicate delegation consumer: {consumer_id}")
            path = pathlib.Path(source["path"])
            if not path.is_absolute():
                path = CODE / path
            entry = {
                "id": consumer_id,
                "root": path,
                "checks": source["checks"],
            }
            by_id[consumer_id] = entry
            entries.append(entry)

    proxy_pins = {}
    for proxy in config.get("proxy", []):
        consumer_id = proxy["consumer"]
        if consumer_id not in by_id:
            raise SystemExit(f"unknown proxy consumer: {consumer_id}")
        path = by_id[consumer_id]["root"] / proxy["path"]
        if path in proxy_pins:
            raise SystemExit(f"duplicate delegation proxy: {path}")
        proxy_pins[path] = (proxy["model"], proxy["effort"])
    return entries, proxy_pins


def main():
    models = load(ROOT / "routing" / "models.toml").get("model", [])
    profiles = load(ROOT / "routing" / "profiles.toml").get("profile", [])
    literals = {model["id"] for model in models}
    for profile in profiles:
        for route in [profile, *profile.get("variant", [])]:
            if route.get("backend_model"):
                literals.add(route["backend_model"])

    consumers, proxy_pins = configured_consumers()
    missing = [consumer["root"] for consumer in consumers if not consumer["root"].exists()]
    if missing:
        for path in missing:
            print(f"missing delegation consumer: {path}")
        return 2

    missing_proxies = [path for path in proxy_pins if not path.is_file()]
    if missing_proxies:
        for path in missing_proxies:
            print(f"missing delegation proxy: {path}")
        return 2

    problems = []
    for consumer in consumers:
        checks = set(consumer.get("checks", []))
        for path in files_under(consumer["root"]):
            try:
                text = path.read_text()
            except UnicodeDecodeError:
                continue
            for line_number, line in enumerate(text.splitlines(), 1):
                if "roster-literals" in checks:
                    found = sorted(literal for literal in literals if literal in line)
                    if found:
                        problems.append(f"{path}:{line_number}: concrete route literal: {', '.join(found)}")
                stripped = line.strip()
                if "agent-frontmatter" in checks and path.suffix == ".md" and stripped.startswith("model:"):
                    if path not in proxy_pins or stripped != f"model: {proxy_pins[path][0]}":
                        problems.append(f"{path}:{line_number}: delegation source pins model frontmatter")
                if path in proxy_pins and stripped.startswith("effort:") and stripped != f"effort: {proxy_pins[path][1]}":
                    problems.append(f"{path}:{line_number}: proxy shell changed its centrally recorded effort")
                if "pi-route" in checks and '"defaultModel"' in stripped:
                    problems.append(f"{path}:{line_number}: Pi default must use $route, not defaultModel")

    for problem in problems:
        print(problem)
    if problems:
        print(f"\n{len(problems)} consumer routing pin(s); use a named agent-routing profile")
        return 1
    print(f"delegation consumers contain no concrete roster pins across {len(consumers)} declared consumer entries")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
