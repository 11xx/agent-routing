#!/usr/bin/env python3
"""Validate the whole data set: every store, route, pool, price and relation.

Each problem names its store and row. The catalog and policy must be in the
canonical form the emitter writes, notes must be well formed, every route
must resolve to a real model, effort, backend and provider, and every price
must carry the terms the price export can describe.
"""

import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import stores  # noqa: E402
from routing_profiles import data_problems  # noqa: E402


def main() -> int:
    problems = data_problems(ROOT)
    for problem in problems:
        print(problem)
    if problems:
        print(f"\n{len(problems)} problem(s) in {stores.DATA}/")
        return 1
    loaded = stores.load(ROOT)
    print(f"{stores.DATA}/ valid: {len(loaded.models)} models, {len(loaded.policy.get('seat', []))} seats, "
          f"{len(stores.load_notes(ROOT))} notes; route version {loaded.version}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
