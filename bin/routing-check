#!/usr/bin/env python3
"""Answer whether a model/effort is on the prohibition list.

The only question this repository answers mechanically. Prohibitions are a
recorded fact, so a script may assert them; choosing a model for a task is
judgment and stays with the caller.
"""

import pathlib
import sys
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from routing_profiles import UNROUTABLE_MODEL_STATUSES, prohibited_efforts  # noqa: E402


def main(argv):
    if not argv:
        print("usage: agent-routing check <model> [effort]", file=sys.stderr)
        return 2
    model_id, effort = argv[0], (argv[1] if len(argv) > 1 else None)
    with (ROOT / "routing" / "models.toml").open("rb") as handle:
        models = tomllib.load(handle)["model"]

    with (ROOT / "routing" / "profiles.toml").open("rb") as handle:
        profiles = tomllib.load(handle).get("profile", [])
    aliases = {}
    for profile in profiles:
        for route in [profile, *profile.get("variant", [])]:
            if route.get("backend_model"):
                if not route.get("model"):
                    print(f"invalid route {route.get('id', '<missing>')!r}: backend_model requires model", file=sys.stderr)
                    return 2
                aliases[route["backend_model"]] = route["model"]
    model_id = aliases.get(model_id, model_id)

    match = next(
        (m for m in models if model_id in (m["id"], *m.get("aliases", []))),
        None,
    )
    if match is None:
        print(f"unknown model: {model_id}", file=sys.stderr)
        print("known ids: " + " ".join(m["id"] for m in models), file=sys.stderr)
        return 2
    model_id = match["id"]

    if effort is not None:
        known_efforts = {entry["effort"] for entry in match.get("effort", [])}
        if known_efforts and effort not in known_efforts:
            print(f"unknown effort for {model_id}: {effort}", file=sys.stderr)
            print("known efforts: " + " ".join(sorted(known_efforts)), file=sys.stderr)
            return 2

    banned = prohibited_efforts(match, effort)
    if banned:
        print(f"prohibited: {model_id} at {' '.join(banned)}", file=sys.stderr)
        print("never select these, including on explicit request", file=sys.stderr)
        return 1

    if effort is not None:
        tier = next((entry for entry in match.get("effort", []) if entry["effort"] == effort), None)
        if tier and tier.get("status") == "explicit-only":
            print(f"explicit-only: {model_id} at {effort} — requires a direct user request")
            return 0

    if match.get("status") in UNROUTABLE_MODEL_STATUSES:
        print(f"{match['status']}: {model_id} — {match.get('role', '')}")
        return 0
    print(f"not prohibited: {model_id}" + (f" at {effort}" if effort else ""))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
