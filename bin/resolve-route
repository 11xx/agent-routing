#!/usr/bin/env python3
"""Resolve one caller-selected task profile into a concrete backend route."""

import argparse
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from routing_profiles import RouteRefusal, dumps, resolve  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="agent-routing resolve",
        description="Resolve a profile only at an effort supported by its backend and model.",
    )
    parser.add_argument("profile")
    parser.add_argument("--backend", required=True)
    parser.add_argument("--variant")
    parser.add_argument(
        "--author",
        help="diff author model[#effort]; review routes only; requires a nonblank family and review_tier or unseated author_floor",
    )
    parser.add_argument(
        "--accept-ineligible",
        action="store_true",
        help="with --author, return the strongest seat when none is eligible, marked ineligible with its qualifiers and debt kind",
    )
    parser.add_argument("--caller", help="observed caller model#effort; adds an advisory confirmation block")
    parser.add_argument("--caller-provider", help="observed caller pool; required when its model belongs to multiple pools")
    parser.add_argument("--allow-experimental", action="store_true")
    parser.add_argument(
        "--allow-cross-pool",
        action="store_true",
        help="spend a pool's allowance on a model another subscription already pays for",
    )
    parser.add_argument("--json", action="store_true", required=True, help="emit the stable JSON route contract")
    args = parser.parse_args()
    try:
        route = resolve(
            ROOT,
            args.profile,
            args.backend,
            variant_id=args.variant,
            allow_experimental=args.allow_experimental,
            allow_cross_pool=args.allow_cross_pool,
            caller=args.caller,
            caller_provider=args.caller_provider,
            author=args.author,
            accept_ineligible=args.accept_ineligible,
        )
    except RouteRefusal as refusal:
        # Stdout carries the route contract and nothing else, so a caller can
        # parse it without first deciding whether it succeeded. The refusal
        # goes to stderr: prose for a person, then the payload alone on the
        # final line for the caller that has to decide what to do about it.
        print(f"agent-routing: cannot resolve profile {args.profile!r} for backend {args.backend!r}: {refusal}", file=sys.stderr)
        print(dumps(refusal.payload()), file=sys.stderr)
        return 1
    except Exception as error:
        # Every refusal ends with a payload, including the ones raised before a
        # RouteRefusal could be built: malformed TOML and a missing manifest key
        # fail while the manifests are being read, and a caller that has to
        # decide what to do cannot be asked to parse prose for those alone.
        print(f"agent-routing: cannot resolve profile {args.profile!r} for backend {args.backend!r}: {error}", file=sys.stderr)
        print(
            dumps(
                {
                    "schema": "agent-routing-refusal/1",
                    "kind": "manifest-invalid",
                    "message": str(error),
                    "profile": args.profile,
                    "backend": args.backend,
                }
            ),
            file=sys.stderr,
        )
        return 1
    print(dumps(route))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
