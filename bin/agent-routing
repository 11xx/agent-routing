#!/usr/bin/env bash
# Path-free access to the routing data. Any harness, skill, or script on this
# machine runs `agent-routing <verb>` without knowing where the data lives.
# This script resolves its own location, so symlinking it anywhere on PATH
# keeps working and moving the repository needs no edit anywhere else.
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
root=$(cd "$(dirname "$self")/.." && pwd)
data_dir="$root/data"

usage() {
  cat <<'EOF'
usage: agent-routing <verb> [args]

Run `agent-routing` with no verb for the routing guide.

  guide               print the routing guide (also the bare invocation)
  models              print the catalog: models, tiers, prices, reachability
  profiles            print the policy: profiles, seats, pools, fallbacks
  delegation          print the backend, reachability and pool rows
  all                 print the catalog, the policy and the field notes
  dir                 print the data directory
  root                print the repository root
  doctrine            render the principles and the policy from the stores
  mechanism           print the delegation mechanism canon (DELEGATION.md)
  lint                validate the whole data set, naming each offending row
  format [--check]    rewrite the stores in canonical form, or name those that are not
  lint-consumers      reject concrete roster pins in delegation consumers
  seats [--json]      project profile/variant bindings and the declared head default
  routes --json [--backend <backend>] [--profile <profile>]
                      list resolvable picker routes and prohibited tiers
  prices [--format tapes] [--output <file>]
                      print API list prices, or write a tapes-price-table/2 file
  set-seat / remove-seat / default-seat    edit a profile seat or its default
  prohibit / allow / rank                   edit a tier ban or capability
  set-fallback / remove-fallback            edit an exhaustion fallback
  set-review-seat / remove-review-seat      edit the reader for a review purpose
  set-guard / retire-guard                  edit a standing instruction
  add-model / supersede-model               edit catalog membership
  note / again / retract / supersede        append field evidence or its disposition
  notes / card / log                        inspect evidence and edit history
  commit / undo                            commit hand edits or reverse a verb edit
    Edit verbs take --dry-run and --json; catalog and policy edits require --why.
    Run an edit verb with --help for its arguments.
  check <model> [eff] exit non-zero if that model/effort is prohibited
  resolve <profile> --backend <backend> [--variant <name>] [--author <model>[#effort]]
          [--purpose findings|clearance|exhaustive] [--allow-experimental] [--accept-ineligible]
          [--usage-file <file>] --json
                      resolve a caller-selected task profile
  validate --profile <profile> --backend <backend> --model <model>
           --effort <effort> --provider <provider> --reason <text>
           [--allow-experimental | --operator-named] [--allow-cross-pool] --json
                      validate an operator-directed tuple without resolving it
  admit-review --author <model>[#effort] --usage-file <file> --base <base> --head <head> --json
                      select quota-admitted independent review or typed review debt
  assess --reviewer <model>#<effort> --author <model>[#<effort>] [--author ...]
         [--purpose findings|clearance] [--as-of <RFC3339> [--accepted <ref>]] [--schema 1|2] [--json]
                      whether a reviewer's findings can be trusted and whether it clears debt
  ladder --json [--history] [--accepted <ref>]
                      export the dated capability ladder for Arc
  frontier --author <model>[#<effort>] [--reads <model>#<effort>...] [--json]
                      the strongest eligible review seat for an author
  emit claude-agents [--profile <shape>] [--variant <variant>] [--allow-experimental]
                     [--output-dir <dir>] [--check]
                      emit static Claude agent definitions and their pins

`resolve` never classifies a task: the caller chooses the profile. Run the
guide for the complete contracts.
EOF
}

case "${1:-}" in
  "")         cat "$root/doctrine/guide.md" ;;
  guide)      cat "$root/doctrine/guide.md" ;;
  help|-h|--help) usage ;;
  models)     cat "$data_dir/catalog.toml" ;;
  profiles)   cat "$data_dir/policy.toml" ;;
  delegation) exec "$root/bin/show-data" delegation ;;
  all)        cat "$data_dir/catalog.toml"; echo; cat "$data_dir/policy.toml"; echo; cat "$data_dir/notes.jsonl" ;;
  dir)        echo "$data_dir" ;;
  root)       echo "$root" ;;
  doctrine)   exec "$root/bin/show-data" doctrine ;;
  mechanism)  cat "$root/DELEGATION.md" ;;
  lint)       exec "$root/bin/lint-routing" ;;
  format)     shift; exec "$root/bin/show-data" format "$@" ;;
  lint-consumers) exec "$root/bin/lint-consumers" ;;
  seats)      shift; exec "$root/bin/show-seats" "$@" ;;
  routes)     shift; exec "$root/bin/list-routes" "$@" ;;
  prices)     shift; exec "$root/bin/price-export" "$@" ;;
  check)      shift; exec "$root/bin/routing-check" "$@" ;;
  resolve)    shift; exec "$root/bin/resolve-route" "$@" ;;
  validate)   shift; exec "$root/bin/validate-selection" "$@" ;;
  admit-review) shift; exec "$root/bin/admit-review" "$@" ;;
  assess)     shift; exec "$root/bin/assess-review" "$@" ;;
  ladder)     shift; exec "$root/bin/review-ladder" "$@" ;;
  frontier)   shift; exec "$root/bin/frontier-review" "$@" ;;
  set-seat|remove-seat|default-seat|prohibit|allow|rank|set-fallback|remove-fallback|set-review-seat|remove-review-seat|set-guard|retire-guard|add-model|supersede-model|note|again|retract|supersede|notes|card|commit|log|undo)
              exec "$root/bin/edit-data" "$@" ;;
  emit)       shift; exec "$root/bin/emit-claude-agents" "$@" ;;
  *)          usage >&2; exit 2 ;;
esac
