#!/usr/bin/env bash
# Path-free access to the routing manifests. Any harness, skill, or script on
# this machine runs `agent-routing <verb>` without knowing where the data
# lives. This script resolves its own location, so symlinking it anywhere on
# PATH keeps working and moving the repository needs no edit anywhere else.
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")
root=$(cd "$(dirname "$self")/.." && pwd)
routing_dir="$root/routing"

usage() {
  cat <<'EOF'
usage: agent-routing <verb> [args]

Run `agent-routing` with no verb for the routing guide.

  guide               print the routing guide (also the bare invocation)
  models              print the model/effort matrix (models.toml)
  profiles            print the named delegation profiles (profiles.toml)
  delegation          print the delegation mechanism matrix (delegation.toml)
  mechanism           print the mechanism-routing prose canon (DELEGATION.md)
  doctrine            print the authored routing policy in full
  lint                check pass@1/cost cells, model coverage, and routes
  lint-consumers      reject concrete roster pins in delegation consumers; fail when an
                      accessor reports fewer sources than its declared floor
  eras                list the model-era history files
  dir                 print the routing data directory
  root                print the repository root
  all                 print all three manifests
  check <model> [eff] exit non-zero if that model/effort is prohibited
  resolve <profile> --backend <backend> [--variant <name>] [--author <model>[#effort]]
          [--allow-experimental] [--accept-ineligible] --json
                      resolve a caller-selected task profile
  assess --reviewer <model>#<effort> --author <model>[#<effort>] [--author ...] [--json]
                      assess any reviewer against the authors of a diff
  validate --profile <profile> --backend <backend> --model <model>
           --effort <effort> --provider <provider> --reason <text>
           [--allow-experimental] [--allow-cross-pool] --json
                      validate an operator-directed tuple without resolving it

`resolve` never classifies a task: the caller chooses the profile. It only maps
that recorded choice to the current provider, model, and effort. `validate`
keeps the profile as an execution shape while validating an explicit model
selection. Both enforce declared backend/model effort support; opt-ins cannot
waive it. `check` remains limited to the prohibition list.
Review author requirements use a seated tier's review_tier or an unseated
tier's author_floor; an author_floor grants no reviewer seat. Superseded
authors with shipped diffs retain floors at least as high as their successors.
`assess` applies the same floors to any reviewer, seated or not, and names why
a read is ineligible; `resolve --accept-ineligible` returns the strongest seat
with that assessment when no eligible one exists.
EOF
}

check() {
  exec "$root/bin/routing-check" "$@"
}

case "${1:-}" in
  "")         cat "$root/doctrine/guide.md" ;;
  guide)      cat "$root/doctrine/guide.md" ;;
  help|-h|--help) usage ;;
  models)     cat "$routing_dir/models.toml" ;;
  profiles)   cat "$routing_dir/profiles.toml" ;;
  delegation) cat "$routing_dir/delegation.toml" ;;
  mechanism)  cat "$root/DELEGATION.md" ;;
  doctrine)   cat "$root/doctrine/model-routing.md" ;;
  lint)       exec "$root/bin/lint-routing" ;;
  lint-consumers) exec "$root/bin/lint-consumers" ;;
  eras)       ls -1 "$root/eras" ;;
  dir)        echo "$routing_dir" ;;
  root)       echo "$root" ;;
  all)        cat "$routing_dir/models.toml"; echo; cat "$routing_dir/profiles.toml"; echo; cat "$routing_dir/delegation.toml" ;;
  check)      shift; check "$@" ;;
  assess)     shift; exec "$root/bin/assess-review" "$@" ;;
  resolve)    shift; exec "$root/bin/resolve-route" "$@" ;;
  validate)   shift; exec "$root/bin/validate-selection" "$@" ;;
  *)          usage >&2; exit 2 ;;
esac
