#!/usr/bin/env python3
"""Serve the routing page for this checkout on a free loopback port until interrupted."""

import argparse
import pathlib
import sys
import webbrowser

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from routing_page import PageServer  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="agent-routing page", description=__doc__)
    parser.add_argument("--no-open", action="store_true", help="print the address without opening a browser")
    args = parser.parse_args()
    server = PageServer(ROOT)
    print(f"routing page for {ROOT}\n{server.url}\nCtrl-C stops it.", flush=True)
    if not args.no_open:
        webbrowser.open(server.url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
