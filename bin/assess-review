#!/usr/bin/env python3
"""Assess a reviewer against the authors of the diff it read."""

import argparse
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from routing_profiles import REVIEW_PURPOSES, RouteRefusal, assess_review, dumps  # noqa: E402


def coordinate(row: dict) -> str:
    return row["model"] + (f"#{row['effort']}" if row["effort"] else "")


def qualified(assessment: dict) -> str:
    return (",".join(assessment["qualifiers"]) or "none") + "".join(
        f"; {reason}" for reason in assessment.get("purpose_qualifiers", []))


def line(assessment: dict) -> str:
    authors = ", ".join(f"{coordinate(row)} (floor {row['floor']})" for row in assessment["authors"])
    reviewer = assessment["reviewer"]
    qualifiers = qualified(assessment)
    return (
        f"{assessment['independence']}: reviewer {coordinate(reviewer)} (tier {reviewer["review_tier"] or "unseated"}) "
        f"against {authors}; qualifiers {qualifiers}"
    )


def line_v2(assessment: dict) -> str:
    """One line leading with the answer to the purpose asked, then the other answer."""
    authors = ", ".join(f"{coordinate(row)} (floor {row['floor']})" for row in assessment["authors"])
    reviewer = assessment["reviewer"]
    qualifiers = qualified(assessment)
    findings = f"findings {assessment['findings']}"
    clears = "clears" if assessment["clears"] else "does not clear"
    asked, other = (clears, findings) if assessment["purpose"] == "clearance" else (findings, clears)
    return (
        f"{asked}: reviewer {coordinate(reviewer)} (tier {reviewer['review_tier'] or 'unseated'}, "
        f"clearance {assessment['clearance']}) against {authors}; {other}; qualifiers {qualifiers}"
    )


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="agent-routing assess",
        description="Assess whether a reviewer's read can report findings on, and clear, the authors of a diff.",
    )
    parser.add_argument("--reviewer", required=True, metavar="MODEL[#EFFORT]")
    parser.add_argument("--as-of", help="read the accepted capability table at an RFC 3339 instant")
    parser.add_argument("--accepted", metavar="REF", help="accepted history ref for --as-of; defaults to the repository default branch")
    parser.add_argument(
        "--author",
        action="append",
        required=True,
        metavar="MODEL[#EFFORT]",
        help="a diff author; repeat for each; omitting #effort uses the highest declared floor",
    )
    parser.add_argument(
        "--purpose",
        choices=REVIEW_PURPOSES,
        help="the question asked of the read: findings, clearance of review debt (the default), or an "
        "exhaustive read chosen for capability, which never clears; both answers are always reported",
    )
    parser.add_argument(
        "--schema",
        type=int,
        choices=(1, 2),
        default=2,
        help="the assessment version to emit; 1 answers independence alone and refuses --purpose findings",
    )
    parser.add_argument("--json", action="store_true", help="emit the agent-routing-assessment contract")
    args = parser.parse_args()
    try:
        assessment = assess_review(ROOT, args.reviewer, args.author, purpose=args.purpose, schema=args.schema, as_of=args.as_of, accepted=args.accepted)
    except RouteRefusal as refusal:
        print(f"agent-routing: cannot assess reviewer {args.reviewer!r}: {refusal}", file=sys.stderr)
        print(dumps(refusal.payload()), file=sys.stderr)
        return 2 if refusal.kind in {"invalid-purpose", "invalid-accepted"} else 1
    if args.json:
        print(dumps(assessment))
    else:
        print(line(assessment) if args.schema == 1 else line_v2(assessment))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
