#!/usr/bin/env python3
"""Print the guide's map, its topic index, one topic, a search, or every topic."""

import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import guide  # noqa: E402

if __name__ == "__main__":
    sys.stdout.write(guide.main(ROOT, sys.argv[1:]))
